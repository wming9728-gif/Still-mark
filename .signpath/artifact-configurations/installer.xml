<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer" (copy of the one stored on signpath.io).
  Signs StillMark-<version>-setup.exe, which .github/workflows/build.yml builds from the files signed with "app-files".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="StillMark-${version}-setup.exe" product-name="Still mark" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
