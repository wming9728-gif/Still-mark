<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>InkPage</AssemblyName>
    <RootNamespace>InkPage</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>InkPage</Product>
    <Description>Markdown reader and editor</Description>
    <NeutralLanguage>en</NeutralLanguage>
    <Copyright>Copyright © 2026 InkPage contributors</Copyright>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <!--
    The test automation channel (the "automation <pipe name>" command-line option) is compiled into Debug builds only,
    or into any build made with -p:InkPageAutomation=true (tools\publish.ps1 -WithAutomation). Release builds,
    including the official package, do not contain it at all.
  -->
  <PropertyGroup>
    <InkPageAutomation Condition="'$(InkPageAutomation)' == '' and '$(Configuration)' == 'Debug'">true</InkPageAutomation>
    <DefineConstants Condition="'$(InkPageAutomation)' == 'true'">$(DefineConstants);AUTOMATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(InkPageAutomation)' != 'true'">
    <Compile Remove="MainWindow.Automation.cs;Services\AutomationServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InkPage.Core\InkPage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Content Include="web\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Builds run portable (data next to the exe). Published output gets the marker only from tools\publish.ps1,
         so the installer's files carry none and the installed program uses %LOCALAPPDATA%\InkPage. -->
    <None Update="portable.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
