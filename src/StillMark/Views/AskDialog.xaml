<Window x:Class="StillMark.Views.AskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Still mark" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" MinWidth="380" MaxWidth="560"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Fg}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="24,20,24,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="IconText" FontFamily="{StaticResource Font.Icon}" FontSize="20" Margin="0,1,12,0"
                           VerticalAlignment="Top" Foreground="{DynamicResource Brush.Accent}"/>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="440"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" Margin="32,10,0,0" TextWrapping="Wrap" MaxWidth="440"
                       Foreground="{DynamicResource Brush.Mute}" LineHeight="20"/>
            <TextBox x:Name="DetailBox" Margin="32,10,0,0" Visibility="Collapsed" IsReadOnly="True" MaxHeight="160"
                     Style="{StaticResource FieldBox}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource Brush.Page}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12"/>
        </Border>
    </Grid>
</Window>
